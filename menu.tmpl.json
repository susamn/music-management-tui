{
  "title": "music-tui",
  "theme": "@THEME@",
  "clamp_threshold": 10,
  "sections": [
    {
      "title": "Lyrics — sync & report",
      "items": [
        {
          "key": "1",
          "label": "lrc-sync — hand-time .txt into .lrc against MPD",
          "cmd": "python3 \"$SELF/bin/lrc-sync.py\"",
          "interactive": true
        },
        {
          "key": "2",
          "label": "Refresh coverage reports (still-missing lists)",
          "cmd": "python3 \"$SELF/bin/refresh-reports.py\""
        },
        {
          "key": "3",
          "label": "Browse still-missing songs",
          "cmd": "cat \"$MUSIC_METADATA_DIR/lyrics-reports/still_missing_songs.txt\"",
          "use_fzf": true
        }
      ]
    },
    {
      "title": "Lyrics — fetch from LRCLIB",
      "items": [
        {
          "key": "1",
          "label": "Fetch plain .txt for tracks missing it",
          "cmd": "python3 \"$SELF/bin/fetch-lyrics.py\" --kind plain --music \"$MUSIC_DIR\" --out \"$MUSIC_METADATA_DIR/lyrics\"",
          "interactive": true
        },
        {
          "key": "2",
          "label": "Fetch synced .lrc for tracks missing it",
          "cmd": "python3 \"$SELF/bin/fetch-lyrics.py\" --kind lrc --music \"$MUSIC_DIR\" --out \"$MUSIC_METADATA_DIR/lyrics\"",
          "interactive": true
        },
        {
          "key": "3",
          "label": "Fetch word-synced .elrc (A2) where available",
          "cmd": "python3 \"$SELF/bin/fetch-lyrics.py\" --kind elrc --music \"$MUSIC_DIR\" --out \"$MUSIC_METADATA_DIR/lyrics\"",
          "interactive": true
        },
        {
          "key": "4",
          "label": "Fetch .txt for one sub-path (prompts)",
          "cmd": "read -rp 'sub-path under music dir (e.g. adele/25): ' p && python3 \"$SELF/bin/fetch-lyrics.py\" --kind plain --music \"$MUSIC_DIR\" --out \"$MUSIC_METADATA_DIR/lyrics\" --only \"$p\"",
          "interactive": true
        }
      ]
    },
    {
      "title": "Lyrics — push to music dir / Drive",
      "items": [
        {
          "key": "1",
          "label": "List lyrics git hasn't committed yet",
          "cmd": "python3 \"$SELF/bin/lyrics-push.py\" list"
        },
        {
          "key": "2",
          "label": "Pick some → copy next to the mp3 (for sync testing)",
          "cmd": "sel=$(python3 \"$SELF/bin/lyrics-push.py\" list | fzf -m --prompt='to music> ') && [ -n \"$sel\" ] && printf '%s\\n' \"$sel\" | python3 \"$SELF/bin/lyrics-push.py\" to-music",
          "interactive": true
        },
        {
          "key": "3",
          "label": "Pick some → push to Google Drive (rclone)",
          "cmd": "sel=$(python3 \"$SELF/bin/lyrics-push.py\" list | fzf -m --prompt='to drive> ') && [ -n \"$sel\" ] && printf '%s\\n' \"$sel\" | python3 \"$SELF/bin/lyrics-push.py\" to-drive",
          "interactive": true
        },
        {
          "key": "4",
          "label": "Pick some → push to Google Drive — dry run",
          "cmd": "sel=$(python3 \"$SELF/bin/lyrics-push.py\" list | fzf -m --prompt='to drive> ') && [ -n \"$sel\" ] && printf '%s\\n' \"$sel\" | python3 \"$SELF/bin/lyrics-push.py\" to-drive --dry-run",
          "interactive": true
        },
        {
          "key": "5",
          "label": "List recent lyrics commits (+ pushed-to-Drive status)",
          "cmd": "python3 \"$SELF/bin/lyrics-push.py\" commits -n 5",
          "use_fzf": true
        },
        {
          "key": "6",
          "label": "Pick past commits → push their lyrics to Google Drive",
          "cmd": "sel=$(python3 \"$SELF/bin/lyrics-push.py\" commits -n 5 | fzf -m --prompt='push commit> ') && [ -n \"$sel\" ] && printf '%s\\n' \"$sel\" | python3 \"$SELF/bin/lyrics-push.py\" push-commits",
          "interactive": true
        },
        {
          "key": "7",
          "label": "Pick past commits → push to Google Drive — dry run",
          "cmd": "sel=$(python3 \"$SELF/bin/lyrics-push.py\" commits -n 5 | fzf -m --prompt='push commit> ') && [ -n \"$sel\" ] && printf '%s\\n' \"$sel\" | python3 \"$SELF/bin/lyrics-push.py\" push-commits --dry-run",
          "interactive": true
        }
      ]
    },
    {
      "title": "Wiki — track stories",
      "items": [
        {
          "key": "1",
          "label": "Preview the next batch (dry run, no network writes)",
          "cmd": "python3 \"$SELF/bin/wiki-fetch.py\" --dry-run",
          "interactive": true
        },
        {
          "key": "2",
          "label": "Fetch the next batch ($WIKI_BATCH tracks)",
          "cmd": "python3 \"$SELF/bin/wiki-fetch.py\"",
          "interactive": true
        },
        {
          "key": "3",
          "label": "Fetch one sub-path (prompts)",
          "cmd": "read -rp 'sub-path under music dir (e.g. sade/the-best-of-sade): ' p && python3 \"$SELF/bin/wiki-fetch.py\" --only \"$p\"",
          "interactive": true
        },
        {
          "key": "4",
          "label": "Retry tracks previously found to have no data",
          "cmd": "python3 \"$SELF/bin/wiki-fetch.py\" --retry-missing",
          "interactive": true
        }
      ]
    },
    {
      "title": "Playlists & play-stats (Apple Music)",
      "items": [
        {
          "key": "1",
          "label": "Playlist sync — live from Music.app",
          "cmd": "python3 \"$SELF/bin/playlist-sync.py\"",
          "interactive": true
        },
        {
          "key": "2",
          "label": "Playlist sync — from a saved dump (prompts)",
          "cmd": "read -rp 'fetch.js dump path: ' f && python3 \"$SELF/bin/playlist-sync.py\" --from \"$f\"",
          "interactive": true
        },
        {
          "key": "3",
          "label": "Playlist sync — dry run (live)",
          "cmd": "python3 \"$SELF/bin/playlist-sync.py\" --dry-run",
          "interactive": true
        },
        {
          "key": "4",
          "label": "Play-stats sync — live from Music.app",
          "cmd": "python3 \"$SELF/bin/play-stats-sync.py\"",
          "interactive": true
        },
        {
          "key": "5",
          "label": "Play-stats sync — dry run",
          "cmd": "python3 \"$SELF/bin/play-stats-sync.py\" --dry-run",
          "interactive": true
        }
      ]
    },
    {
      "title": "mpdtui DB — read",
      "items": [
        {
          "key": "1",
          "label": "Summary (counts, marks, tags)",
          "cmd": "python3 \"$SELF/bin/mpdtui.py\" summary"
        },
        {
          "key": "2",
          "label": "Browse tracks (id, rating, marks, path)",
          "cmd": "python3 \"$SELF/bin/mpdtui.py\" list",
          "use_fzf": true
        },
        {
          "key": "3",
          "label": "Browse 5★ tracks",
          "cmd": "python3 \"$SELF/bin/mpdtui.py\" list --min-rating 5",
          "use_fzf": true
        },
        {
          "key": "4",
          "label": "Orphan rows (file gone)",
          "cmd": "python3 \"$SELF/bin/mpdtui.py\" orphans"
        }
      ]
    },
    {
      "title": "mpdtui DB — diff",
      "items": [
        {
          "key": "1",
          "label": "vs music library (orphans / drift)",
          "cmd": "python3 \"$SELF/bin/mpdtui.py\" diff-library"
        },
        {
          "key": "2",
          "label": "vs play_stats.csv (ratings / play counts)",
          "cmd": "python3 \"$SELF/bin/mpdtui.py\" diff-stats"
        }
      ]
    },
    {
      "title": "mpdtui DB — write (backup taken first)",
      "items": [
        {
          "key": "1",
          "label": "Backup DB to rclone remote",
          "cmd": "bash \"$SELF/bin/mpdtui-db-backup.sh\" backup",
          "interactive": true
        },
        {
          "key": "2",
          "label": "Restore DB from rclone remote",
          "cmd": "bash \"$SELF/bin/mpdtui-db-backup.sh\" restore",
          "interactive": true
        },
        {
          "key": "3",
          "label": "Add a mark to picked tracks",
          "cmd": "python3 \"$SELF/bin/mpdtui.py\" marks; read -rp 'mark id or name: ' m && python3 \"$SELF/bin/mpdtui.py\" list | fzf -m --prompt='mark> ' | python3 \"$SELF/bin/mpdtui.py\" mark --add \"$m\" --apply",
          "interactive": true
        },
        {
          "key": "4",
          "label": "Add a tag to picked tracks",
          "cmd": "python3 \"$SELF/bin/mpdtui.py\" tags; read -rp 'tag name: ' t && python3 \"$SELF/bin/mpdtui.py\" list | fzf -m --prompt='tag> ' | python3 \"$SELF/bin/mpdtui.py\" tag --add \"$t\" --apply",
          "interactive": true
        },
        {
          "key": "5",
          "label": "Import ratings from play_stats.csv",
          "cmd": "python3 \"$SELF/bin/mpdtui.py\" import-ratings --apply",
          "interactive": true
        },
        {
          "key": "6",
          "label": "Prune orphan rows",
          "cmd": "python3 \"$SELF/bin/mpdtui.py\" prune --apply",
          "interactive": true
        }
      ]
    },
    {
      "title": "Settings",
      "items": [
        {
          "key": "1",
          "label": "Show resolved config + path checks",
          "cmd": "bash \"$SELF/bin/show-config.sh\""
        },
        {
          "key": "2",
          "label": "Edit config ($EDITOR)",
          "cmd": "${EDITOR:-vi} \"${XDG_CONFIG_HOME:-$HOME/.config}/music-tui/config\"",
          "interactive": true
        }
      ]
    }
  ]
}
