# music-tui config -- copied to ~/.config/music-tui/config on first run.
# Plain KEY=VALUE, sourced by music-tui.sh. '~' is expanded. No quotes needed.

# The music-metadata repo: lyrics/, playlists/, lyrics-reports/, play-stats/, files.csv.
MUSIC_METADATA_DIR=~/Music/music-metadata

# The actual music library (mp3s + sidecar .lrc/.txt). Seeded from
# ~/.config/mpdtui/config's music_dir= on first run if that file exists.
MUSIC_DIR=~/Music/susamn-music-collection

# mpdtui's SQLite DB -- play counts, ratings, marks, tags.
MPDTUI_DB=~/.config/mpdtui/mpdtui.db

# Apple Music play-stats snapshot (written by play-stats-sync.py, read by mpdtui.py diff-stats).
PLAY_STATS_CSV=~/Music/music-metadata/play-stats/play_stats.csv

# Slug namespace of the music library, used by playlist-sync.py to match Apple
# paths. Generated by bin/generate-files-csv.py from $GDRIVE_MUSIC_DIR (or
# wherever --root points, on whatever machine you run it from) - regenerate it
# whenever the library changes rather than trusting a stale snapshot.
FILES_CSV=~/Music/music-metadata/files.csv

# rclone remote + base path for the music collection on Google Drive.
# Lyrics pushed to Drive land at <this>/<same nested path as the local music dir>.
RCLONE_MUSIC_REMOTE_PATH=gdrive:Media/Music

# TUI theme: obsidian | dracula | nord | cyberpunk | emerald
THEME=obsidian

# --- MCATALOGID tagging --------------------------------------------------------
# Local Google Drive mount holding the offline music copy (Google Drive.app's
# File Provider folder, e.g.
# ~/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/Media/Music).
# No portable default -- the path embeds your account email. Required by
# bin/mcatalogid-backfill.py.
GDRIVE_MUSIC_DIR=

# Apple Music's own managed copy (only used if "keep library organized" +
# "copy music files" are on in Music.app settings). Read by
# bin/apple-music-tag-sync.py, the one-time catch-up sync.
APPLE_MUSIC_DIR=~/Music/Music/Media.localized/Music

# --- wiki (track stories) -----------------------------------------------------
# Per-track background fetched by bin/wiki-fetch.py and read offline by mpdtui.
# Mirrors the library one level deeper than lyrics/: <artist>/<album>/<track>/.
WIKI_DIR=~/Music/music-metadata/wiki

# Where a sweep records tracks no source knew anything about, so later runs skip
# them (bin/wiki-fetch.py --retry-missing to try again anyway).
WIKI_REPORTS_DIR=~/Music/music-metadata/wiki-reports

# Tracks per sweep. One run is meant to be a known quantity of network traffic;
# run it again for the next batch.
WIKI_BATCH=100

# Wikipedia language edition, and the User-Agent every request carries.
# MusicBrainz rejects requests without a descriptive one.
WIKI_LANG=en
WIKI_USER_AGENT="music-tui/1.0 ( https://github.com/susamn )"

# Service endpoints. Here so they can be repointed (mirror, proxy, API version
# bump) without touching the script.
MUSICBRAINZ_API=https://musicbrainz.org/ws/2
COVERART_API=https://coverartarchive.org
WIKIPEDIA_API=https://{lang}.wikipedia.org
LASTFM_API=https://ws.audioscrobbler.com/2.0/
GENIUS_API=https://api.genius.com
DISCOGS_API=https://api.discogs.com

# Optional API credentials. Leave blank and that source is skipped -- the
# fallback chain moves on, and MusicBrainz / Wikipedia / Cover Art Archive
# still work with no keys at all.
#   Last.fm  https://www.last.fm/api/account/create
#   Genius   https://genius.com/api-clients        (client access token)
#   Discogs  https://www.discogs.com/settings/developers  (personal token)
LASTFM_API_KEY=
GENIUS_TOKEN=
DISCOGS_TOKEN=
